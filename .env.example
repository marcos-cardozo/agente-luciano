# Copiá este archivo como .env y completá los valores.

# API key de Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo. Haiku es rápido y barato, ideal para el prototipo.
ANTHROPIC_MODEL=claude-haiku-5-5

# Base de datos (coincide con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=agente
DB_PASSWORD=agente
DB_NAME=agente_luciano

PORT=3000
